{
  "name": "motionface-claude-editing-remotion",
  "version": "1.0.0",
  "private": true,
  "description": "Editable hand-drawn video editor animation recreated with Remotion",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts EditingStory out/editing-story.mp4",
    "still": "remotion still src/index.ts EditingStory out/preview.png --frame=420",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/lxgw-wenkai": "5.3.0",
    "@remotion/cli": "4.0.532",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "typescript": "5.9.3"
  }
}
